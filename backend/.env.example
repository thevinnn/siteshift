NODE_ENV=development
PORT=4000

# Main application database (trusted app/auth data only).
# The AI subsystem must never receive this connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/siteshift

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

BETTER_AUTH_URL=http://localhost:4000

# Frontend origin allowed to send credentialed requests
CORS_ORIGIN=http://localhost:4200
